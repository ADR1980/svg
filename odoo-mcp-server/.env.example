# Odoo Verbindungsdaten
# URL deiner odoo.sh Instanz (ohne Schrägstrich am Ende)
ODOO_URL=https://deine-instanz.odoo.com

# Datenbankname (sichtbar in der URL oder unter Einstellungen → Technisch)
ODOO_DB=deine-datenbank

# Odoo Benutzername (E-Mail-Adresse)
ODOO_USERNAME=admin@example.com

# API-Key (erstellt unter: Einstellungen → Benutzer → API Keys)
ODOO_API_KEY=dein-api-key
