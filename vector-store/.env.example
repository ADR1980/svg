# Supabase Konfiguration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Embedding Modell
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Konfiguration
API_HOST=0.0.0.0
API_PORT=8000

# KI-Analyse (optional - ohne Key wird der KI-Tab ausgeblendet)
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=2000

# Email-Ingestion (optional - ohne IMAP_HOST wird Email-Polling deaktiviert)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_EMAIL=docs@svg.global
IMAP_PASSWORD=your-email-password
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=300
EMAIL_DEFAULT_LANGUAGE=de
