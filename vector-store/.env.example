# Supabase Konfiguration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Embedding Modell
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Konfiguration
API_HOST=0.0.0.0
API_PORT=8000

# KI-Analyse (optional - ohne Key wird der KI-Tab ausgeblendet)
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=2000

# Email-Ingestion (optional - ohne IMAP_HOST wird Email-Polling deaktiviert)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_EMAIL=docs@svg.global
IMAP_PASSWORD=your-email-password
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=300
EMAIL_DEFAULT_LANGUAGE=de

# Microsoft Graph Email-Ingestion (optional - ohne MSGRAPH_TENANT_ID deaktiviert)
# Azure AD App Registration: Application Permission "Mail.ReadWrite" erforderlich
MSGRAPH_TENANT_ID=your-azure-tenant-id
MSGRAPH_CLIENT_ID=your-app-client-id
MSGRAPH_CLIENT_SECRET=your-client-secret
MSGRAPH_MAILBOX=docs@yourcompany.com
MSGRAPH_POLL_INTERVAL_SECONDS=300

# JWT Authentifizierung
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Alpaca Markets API (optional - ohne ALPACA_API_KEY wird Alpaca deaktiviert)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_PAPER=true

# Trailing-Stop Strategie
TRAILING_STOP_PCT=3.0
TRAILING_MIN_PROFIT_PCT=1.0
TRAILING_CHECK_INTERVAL=30
TRAILING_COST_PER_TRADE=0.0
TRAILING_SPREAD_PCT=0.05
