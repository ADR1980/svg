# Verbindung zum Supabase-Projekt. Beide Werte gehören ins Deployment, nicht
# ins Repository — anders als beim anon key entscheidet hier kein RLS darüber,
# wer die Adresse kennt. Ohne diese Werte läuft die App im Alleingang: alles
# bleibt in IndexedDB auf dem Gerät.
VITE_SUPABASE_URL=https://beispiel.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Voreinstellung: progress-photos. Nur ändern, wenn der Eimer anders heißt.
VITE_SUPABASE_BUCKET=progress-photos
